# --- LLM -------------------------------------------------------------
# gemini | mock  (mock = offline heuristic model for local dev / tests)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# json_schema | mime_only — how structured output is requested (always zod-validated)
GEMINI_STRUCTURED_MODE=json_schema
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# --- Cost & capacity guards ------------------------------------------
# Estimated USD/day from token usage; 0 disables
DAILY_BUDGET_USD=5
MAX_CONCURRENT_PIPELINES=8

# --- HTTP ------------------------------------------------------------
PORT=5000
ALLOWED_ORIGINS=https://hazircv.com.tr,https://www.hazircv.com.tr,http://localhost:5173
ALLOWED_ORIGIN_PATTERN=^https://resumatch-v2(-[a-z0-9-]+)?\.vercel\.app$
TRUST_PROXY=1
LOG_LEVEL=info

# Temporary: keep the v2 client's /optimize endpoint during the rollout
ENABLE_LEGACY_OPTIMIZE=false

# --- Başvuru otomasyonu (Supabase) ------------------------------------
# Supabase → Project Settings → API. İkisi birlikte verilmeli; boşsa modül kapalı.
SUPABASE_URL=
# GİZLİ: sadece sunucuda tutulur, istemciye/repoya asla konmaz.
SUPABASE_SERVICE_ROLE_KEY=

# --- Faz 2: Gmail ile gönderim ve günlük işçi -------------------------
# Google Cloud → OAuth istemcisi (hazircv-web). Yönlendirme adresi:
#   <API_PUBLIC_URL>/api/v1/automation/gmail/callback
GOOGLE_CLIENT_ID=
# GİZLİ
GOOGLE_CLIENT_SECRET=
# GİZLİ: Gmail refresh token'larını şifreler. Uzun rastgele bir değer; değişirse bağlantılar yenilenmeli.
TOKEN_ENC_KEY=
# GİZLİ: GitHub Actions günlük tetikleyicisi bu değeri gönderir (repo sırrı CRON_SECRET ile aynı).
CRON_SECRET=
# İlan araması: önce Tavily (ayda 1000 ücretsiz), yedek SerpApi (ayda 250).
TAVILY_API_KEY=
SERPAPI_KEY=
SEARCHES_PER_USER=4
PAGES_PER_USER=10
API_PUBLIC_URL=https://resumatch-backend-zsmt.onrender.com
APP_URL=https://hazircv.com.tr
